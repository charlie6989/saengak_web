# Public browser configuration. This value is safe to expose, but it must point
# to the Supabase project used by the site and the Vercel API.
VITE_PUBLIC_SUPABASE_URL=
# Preferred for new projects.
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT key fallback only; do not set both key variables.
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Local Supabase Google OAuth provider. Store real values only in the ignored
# root .env file; production credentials are managed in the Supabase dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Server-side Supabase Edge Function configuration. Shopify Storefront 2026-07
# supports tokenless Products/Collections/Cart access; the token is optional and
# only needed for fields/scopes that require token-based access.
ShopifyDomain=
StorefrontAccessToken=
ShopifyStorefrontApiVersion=2026-07
# Server-only checkout kill switch. Keep false until the sandbox suite is approved.
CheckoutReleaseEnabled=false
CheckoutAllowedOrigins=https://saengak.com.tw,https://saengak-web-d2ux.vercel.app

# Shopify app client secret used only by the webhook Edge Function to verify
# X-Shopify-Hmac-Sha256. Never expose this value through a VITE_PUBLIC variable.
ShopifyWebhookSecret=

# Server-only Amego invoice worker configuration. Set these only as Supabase
# Edge Function secrets; never prefix them with VITE_ or commit real values.
AmegoInvoiceReleaseEnabled=false
AmegoMode=test
AmegoSellerTaxId=
AmegoAllowedSellerTaxIds=12345678
AmegoAppKey=
AmegoDispatchToken=

# ShipAny is installed and configured inside the SAENGAK Shopify admin. The
# website/Supabase integration intentionally has no ShipAny API key.
