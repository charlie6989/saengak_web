# Public browser configuration. This value is safe to expose, but it must point
# to the Supabase project used by the site and the Vercel API.
VITE_PUBLIC_SUPABASE_URL=
# Preferred for new projects.
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT key fallback only; do not set both key variables.
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Local Supabase Google OAuth provider. Store real values only in the ignored
# root .env file; production credentials are managed in the Supabase dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Server-side Supabase Edge Function configuration. Shopify Storefront 2026-07
# supports tokenless Products/Collections/Cart access; the token is optional and
# only needed for fields/scopes that require token-based access.
ShopifyDomain=
StorefrontAccessToken=
ShopifyStorefrontApiVersion=2026-07
CheckoutAllowedOrigins=https://lucissicare.com,https://www.lucissicare.com,https://saengak-web-d2ux.vercel.app

# Shopify app client secret used only by the webhook Edge Function to verify
# X-Shopify-Hmac-Sha256. Never expose this value through a VITE_PUBLIC variable.
ShopifyWebhookSecret=

# Server-only Amego invoice worker configuration. Set these only as Supabase
# Edge Function secrets; never prefix them with VITE_ or commit real values.
AmegoInvoiceReleaseEnabled=false
AmegoMode=test
AmegoSellerTaxId=
AmegoAllowedSellerTaxIds=12345678
AmegoAppKey=
AmegoDispatchToken=
# Provider-visible note identifying the issuing storefront (never a secret).
AmegoIssuerNote=LUCISSI CARE 商店開立

# ShipAny is installed and configured inside the LUCISSI CARE Shopify admin. The
# website/Supabase integration intentionally has no ShipAny API key.

# Additional app / Vercel API / image-generation settings. Obtain values from the project owner.
VITE_PUBLIC_SHOPIFY_STORE_DOMAIN=
VITE_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
VITE_PUBLIC_SHOPIFY_API_VERSION=
VITE_PUBLIC_SHOPIFY_STOREFRONT_ENABLED=
VITE_PUBLIC_SHOPIFY_TAGS_ENABLED=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
# Supabase Auth CAPTCHA only; requires matching Supabase Auth provider settings.
VITE_PUBLIC_TURNSTILE_SITE_KEY=
# Guest checkout CAPTCHA only; does not enable CAPTCHA on member login/register.
VITE_PUBLIC_GUEST_CHECKOUT_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret for guest checkout (api/create-shopify-cart). Guest checkout fails closed without it.
TURNSTILE_SECRET_KEY=
# Optional comma-separated hostnames accepted from Turnstile siteverify (replaces lucissicare.com, www.lucissicare.com, localhost).
TURNSTILE_ALLOWED_HOSTNAMES=
GEMINI_API_KEY=
PHOTOROOM_API_KEY=
PHOTOROOM_SANDBOX_API_KEY=
CRON_SECRET=

# LUCISSI ↔ LUCISSI CARE member recognition (phase 1). Server-only; never prefix with VITE_PUBLIC.
# Same 32+ character secret on both Vercel projects; the URL is the parent site's endpoint.
PARTNER_MEMBER_SECRET=
PARTNER_MEMBER_STATUS_URL=https://lucissi.com/api/partner/member-status
# Server switch for issuing perk codes (each member gets their own single-use Shopify discount;
# the Shopify app needs write_discounts, read_customers and write_customers).
LUCISSI_MEMBER_PERK_ENABLED=false
# Bind each perk discount to the member's Shopify customer (default true). Set false only if a
# rollout test shows Shopify cannot apply customer-specific codes at this store's checkout.
LUCISSI_MEMBER_PERK_BIND_CUSTOMER=true
# Show the perk card only after the server values above are set in production.
VITE_PUBLIC_LUCISSI_MEMBER_PERK_ENABLED=false

# COD 收款後開票：需先完成物流金額對應、會計確認、唯一開票來源與實單驗收。
# API + DB private.cod_invoice_policy 必須同時放行；UI flag 不是授權依據。
COD_COLLECTION_ENABLED=false
COD_COLLECTION_PAYMENT_ENABLED=false
VITE_PUBLIC_COD_COLLECTION_ENABLED=false
# Exact values from verified CARE ShipAny Black Cat ambient fulfillment, never generic title guesses.
COD_SHIPANY_SERVICE_ID=
COD_BLACK_CAT_TRACKING_COMPANY=
COD_BLACK_CAT_AMBIENT_SHIPPING_CODE=
# Enable only after owner-system full order -> shipment COD amount mapping acceptance.
COD_SHIPANY_AMOUNT_MAPPING_VERIFIED=false
